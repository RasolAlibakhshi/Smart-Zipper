{
  "name": "smart-zipper",
  "version": "1.0.0",
  "description": "Electron ZIP creator with size view, ignore and filters",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --linux",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "archiver": "^7.0.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "author": "Smart Zipper",
  "license": "MIT",
  "build": {
    "appId": "com.smartzipper.app",
    "productName": "Smart Zipper",
    "artifactName": "SmartZipper-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "compression": "maximum",
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SmartZipper-${version}-win-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "SmartZipper-${version}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Smart Zipper <app@smartzipper.local>",
      "synopsis": "Smart project zipper for AI"
    },
    "portable": {
      "artifactName": "SmartZipper-${version}-win-${arch}-portable.${ext}"
    }
  }
}